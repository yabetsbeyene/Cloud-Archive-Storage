# Local Docker uses Mailpit by default. Replace these values with your
# organization's SMTP provider to deliver invitations to real inboxes.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@digital-archive.local
SMTP_FROM_DISPLAY_NAME=Digital Archive
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
