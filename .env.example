# Application URLs
APP_PUBLIC_URL=http://localhost:5173
FRONTEND_PORT=5173
POSTGRES_PORT=5533

# Required secrets
DB_PASSWORD=replace-with-a-strong-database-password
KEYCLOAK_DB_PASSWORD=replace-with-a-strong-keycloak-database-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-keycloak-admin-password
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-a-strong-client-secret

# SMTP. Mailpit is the local default.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@digital-archive.local
SMTP_FROM_DISPLAY_NAME=Digital Archive
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
