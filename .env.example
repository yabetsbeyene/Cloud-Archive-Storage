# Local Docker uses Mailpit by default. Mailpit only captures messages at
# http://localhost:8025; it does not deliver them to real inboxes.
#
# For real delivery, copy this file to .env and replace these values with your
# organization's SMTP provider. A typical authenticated STARTTLS provider uses
# port 587 with SMTP_AUTH=true, SMTP_STARTTLS=true, and SMTP_SSL=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=yabetsbeyene78@gmail.com
SMTP_FROM_DISPLAY_NAME=Digital Archive
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=yabetsbeyene78@gmail.com
SMTP_PASSWORD=llbi vfjb agwu sgsf