FROM quay.io/keycloak/keycloak:25.0

# Bake the realm config into the image itself — Render deploys a single
# Dockerfile per service, so there's no docker-compose volume mount available
# like in local dev. --import-realm reads everything in this folder on boot.
COPY keycloak/realm-export.json /opt/keycloak/data/import/realm-export.json

# Building the production-optimized image ahead of time (faster cold starts)
RUN /opt/keycloak/bin/kc.sh build

ENTRYPOINT ["/opt/keycloak/bin/kc.sh", "start", "--optimized", "--import-realm"]
