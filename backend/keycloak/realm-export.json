{
  "realm": "digital-archive",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "editUsernameAllowed": true,
  "passwordPolicy": "length(14) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername and notEmail and passwordHistory(5)",
  "emailTheme": "archive-invitation",
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "${SMTP_FROM_DISPLAY_NAME}",
    "auth": "${SMTP_AUTH}",
    "starttls": "${SMTP_STARTTLS}",
    "ssl": "${SMTP_SSL}",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}"
  },
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Full system access" },
      { "name": "ARCHIVIST", "description": "Manages document archival and retention" },
      { "name": "MANAGER", "description": "Approves/rejects documents in workflow" },
      { "name": "DEPT_USER", "description": "Department-level document creation and editing" },
      { "name": "VIEWER", "description": "Read-only access" }
    ]
  },
  "clients": [
    {
      "clientId": "archive-frontend",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "__FRONTEND_URL__/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "__FRONTEND_URL__"
      ]
    },
    {
      "clientId": "archive-backend-admin",
      "name": "Archive backend user management",
      "secret": "__BACKEND_ADMIN_CLIENT_SECRET__",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subType": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"applicationRole\",\"displayName\":\"Application role\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"applicationDepartment\",\"displayName\":\"Application department\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "service-account-archive-backend-admin",
      "enabled": true,
      "serviceAccountClientId": "archive-backend-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "admin.user",
      "enabled": true,
      "firstName": "System",
      "lastName": "Administrator",
      "email": "admin.user@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "ArchiveAdmin123!",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "dept.user",
      "enabled": true,
      "firstName": "Department",
      "lastName": "User",
      "email": "dept.user@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "ArchiveDept123!",
          "temporary": false
        }
      ],
      "realmRoles": ["DEPT_USER"]
    }
  ]
}
