{
  "realm": "digital-archive",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Full system access" },
      { "name": "ARCHIVIST", "description": "Manages document archival and retention" },
      { "name": "MANAGER", "description": "Approves/rejects documents in workflow" },
      { "name": "DEPT_USER", "description": "Department-level document creation and editing" },
      { "name": "VIEWER", "description": "Read-only access" }
    ]
  },
  "clients": [
    {
      "clientId": "archive-backend",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "secret": "archive-backend-secret",
      "redirectUris": [ "http://localhost:8080/*" ],
      "webOrigins": [ "http://localhost:8080" ]
    },
    {
      "clientId": "archive-frontend",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [ "http://localhost:5173/*" ],
      "webOrigins": [ "http://localhost:5173" ]
    }
  ],
  "users": [
    {
      "username": "admin.user",
      "enabled": true,
      "email": "admin.user@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "password123", "temporary": false }
      ],
      "realmRoles": [ "ADMIN" ]
    },
    {
      "username": "dept.user",
      "enabled": true,
      "email": "dept.user@example.com",
      "firstName": "Dept",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "password123", "temporary": false }
      ],
      "realmRoles": [ "DEPT_USER" ]
    }
  ]
}
