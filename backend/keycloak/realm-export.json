{
  "realm": "digital-archive",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "editUsernameAllowed": true,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Full system access" },
      { "name": "ARCHIVIST", "description": "Manages document archival and retention" },
      { "name": "MANAGER", "description": "Approves/rejects documents in workflow" },
      { "name": "DEPT_USER", "description": "Department-level document creation and editing" },
      { "name": "VIEWER", "description": "Read-only access" }
    ]
  },
  "clients": [
    {
      "clientId": "archive-frontend",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "__FRONTEND_URL__/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "__FRONTEND_URL__"
      ]
    },
    {
      "clientId": "archive-backend-admin",
      "name": "Archive backend user management",
      "secret": "__BACKEND_ADMIN_CLIENT_SECRET__",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-archive-backend-admin",
      "enabled": true,
      "serviceAccountClientId": "archive-backend-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "admin.user",
      "enabled": true,
      "firstName": "System",
      "lastName": "Administrator",
      "email": "admin.user@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "dept.user",
      "enabled": true,
      "firstName": "Department",
      "lastName": "User",
      "email": "dept.user@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["DEPT_USER"]
    }
  ]
}
